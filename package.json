{
  "name": "selaras-school-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check . && turbo run typecheck test",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "turbo": "2.10.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
